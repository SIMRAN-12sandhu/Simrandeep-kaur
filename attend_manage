import csv
import os
from datetime import date

STUDENT_FILE = "students.csv"
ATTENDANCE_FILE = "attendance.csv"


# Create files if they don't exist
def initialize_files():
    if not os.path.exists(STUDENT_FILE):
        with open(STUDENT_FILE, "w", newline="") as file:
            writer = csv.writer(file)
            writer.writerow(["Roll No", "Name"])

    if not os.path.exists(ATTENDANCE_FILE):
        with open(ATTENDANCE_FILE, "w", newline="") as file:
            writer = csv.writer(file)
            writer.writerow(["Date", "Roll No", "Name", "Status"])


# Add a student
def add_student():
    roll_no = input("Enter Roll Number: ")
    name = input("Enter Student Name: ")

    with open(STUDENT_FILE, "a", newline="") as file:
        writer = csv.writer(file)
        writer.writerow([roll_no, name])

    print("Student added successfully!")


# Display students
def view_students():
    with open(STUDENT_FILE, "r") as file:
        reader = csv.DictReader(file)

        print("\n--- Student List ---")
        for student in reader:
            print(f"Roll No: {student['Roll No']} | Name: {student['Name']}")


# Mark attendance
def mark_attendance():
    students = []

    with open(STUDENT_FILE, "r") as file:
        reader = csv.DictReader(file)
        students = list(reader)

    if not students:
        print("No students found.")
        return

    today = str(date.today())

    print(f"\nAttendance Date: {today}")
    print("Enter P for Present and A for Absent\n")

    with open(ATTENDANCE_FILE, "a", newline="") as file:
        writer = csv.writer(file)

        for student in students:
            while True:
                status = input(
                    f"{student['Roll No']} - {student['Name']}: "
                ).upper()

                if status in ["P", "A"]:
                    break
                print("Please enter only P or A.")

            writer.writerow([
                today,
                student["Roll No"],
                student["Name"],
                status
            ])

    print("\nAttendance marked successfully!")


# View attendance
def view_attendance():
    print("\n--- Attendance Records ---")

    with open(ATTENDANCE_FILE, "r") as file:
        reader = csv.DictReader(file)

        for record in reader:
            status = "Present" if record["Status"] == "P" else "Absent"

            print(
                f"Date: {record['Date']} | "
                f"Roll No: {record['Roll No']} | "
                f"Name: {record['Name']} | "
                f"Status: {status}"
            )


# Attendance percentage
def attendance_percentage():
    roll_no = input("Enter Roll Number: ")

    total = 0
    present = 0
    student_name = ""

    with open(ATTENDANCE_FILE, "r") as file:
        reader = csv.DictReader(file)

        for record in reader:
            if record["Roll No"] == roll_no:
                total += 1
                student_name = record["Name"]

                if record["Status"] == "P":
                    present += 1

    if total == 0:
        print("No attendance records found.")
        return

    percentage = (present / total) * 100

    print("\n--- Attendance Report ---")
    print("Roll Number:", roll_no)
    print("Name:", student_name)
    print("Total Classes:", total)
    print("Present:", present)
    print("Absent:", total - present)
    print(f"Attendance Percentage: {percentage:.2f}%")


# Main menu
def main():
    initialize_files()

    while True:
        print("\n==============================")
        print(" ATTENDANCE MANAGEMENT SYSTEM")
        print("==============================")
        print("1. Add Student")
        print("2. View Students")
        print("3. Mark Attendance")
        print("4. View Attendance")
        print("5. Attendance Percentage")
        print("6. Exit")

        choice = input("Enter your choice: ")

        if choice == "1":
            add_student()

        elif choice == "2":
            view_students()

        elif choice == "3":
            mark_attendance()

        elif choice == "4":
            view_attendance()

        elif choice == "5":
            attendance_percentage()

        elif choice == "6":
            print("Thank you for using the system!")
            break

        else:
            print("Invalid choice. Please try again.")


if __name__ == "__main__":
    main()